{
  "name": "@onholidai/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write --ignore-path ../.prettierignore \"../**/*.{ts,tsx,js,jsx,mjs,cjs,css,json,jsonc,yaml,yml,md}\"",
    "format:check": "prettier --check --ignore-path ../.prettierignore \"../**/*.{ts,tsx,js,jsx,mjs,cjs,css,json,jsonc,yaml,yml,md}\"",
    "db:migrate": "node --experimental-strip-types server/db/migrate.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:contracts": "vitest run tests/contract --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "snapshot:contract": "node --experimental-strip-types scripts/generate-snapshot-contract.mjs",
    "snapshot:contract:check": "node --experimental-strip-types scripts/generate-snapshot-contract.mjs --check",
    "agent:contracts": "node --experimental-strip-types scripts/generate-agent-contracts.ts",
    "agent:contracts:check": "node --experimental-strip-types scripts/generate-agent-contracts.ts --check",
    "corpus:generate": "node scripts/generate-evaluation-corpus.mjs",
    "corpus:check": "node scripts/generate-evaluation-corpus.mjs --check",
    "db:migrate:test": "vitest run tests/integration/migration-compatibility.test.ts --passWithNoTests",
    "test:foundation": "vitest run --config vitest.foundation.config.ts",
    "test:temporal": "vitest run tests/integration/booking-workflows.test.ts --passWithNoTests",
    "booking:worker": "node --conditions=react-server --experimental-transform-types --import ./server/workflows/alias-loader.mjs server/workflows/worker-entry.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@tanstack/react-query": "5.104.1",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "kysely": "0.29.6",
    "maplibre-gl": "6.13.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@temporalio/testing": "1.24.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "*",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
