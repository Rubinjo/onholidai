{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onholid.ai/contracts/agent-tools/v1",
  "title": "OnHolid.ai Agent Tool Contracts",
  "description": "Allowlisted read and proposal tools. Booking, payment, cancellation, rescheduling, and direct trip mutation tools are intentionally absent.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/GetTripCall"
    },
    {
      "$ref": "#/$defs/ProposeTripChangesCall"
    },
    {
      "$ref": "#/$defs/RetrieveRelevantContextCall"
    }
  ],
  "$defs": {
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "tripId",
        "requestId",
        "baseTripVersion"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "tripId": {
          "type": "string",
          "format": "uuid"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "baseTripVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "GetTripCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tool",
        "context",
        "input"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "tool": {
          "const": "get_trip"
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "detail"
          ],
          "properties": {
            "detail": {
              "enum": [
                "compact",
                "itinerary",
                "components",
                "pricing",
                "constraints"
              ]
            },
            "componentIds": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    },
    "ProposeTripChangesCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tool",
        "context",
        "input"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "tool": {
          "const": "propose_trip_changes"
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "initiatingRequestId",
            "operations",
            "rationale",
            "affectedFacts"
          ],
          "properties": {
            "operations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/DraftOperation"
              }
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "affectedFacts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "maxLength": 200
              }
            },
            "ambiguities": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "purpose": {
              "enum": [
                "initial_estimate",
                "refinement",
                "finalization"
              ]
            },
            "initiatingRequestId": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "DraftOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "target",
        "value"
      ],
      "properties": {
        "operation": {
          "enum": [
            "add",
            "replace",
            "remove",
            "reorder"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^/(departureOrigin|availabilityWindows|duration|travellerParty|preferences|constraints|destinations|itineraryDays|components)(/.*)?$"
        },
        "value": {}
      }
    },
    "RetrieveRelevantContextCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tool",
        "context",
        "input"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "tool": {
          "const": "retrieve_relevant_context"
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query",
            "reason",
            "limit"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "entityIds": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "before": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
