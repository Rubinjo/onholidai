# OnHolid.ai local development template. Copy to .env; never commit real keys.
# The credential-free demo uses deterministic responses and synthetic offers.
# Local demo secrets are intentionally synthetic. Never use them in production.
# .env is the local source of truth for host processes and Docker Compose.

# Web runtime. Production requires explicit authentication/signing secrets.
NODE_ENV=development
# deterministic: no live model/research/supply calls; live: requires your own API access.
PROVIDER_MODE=deterministic
# Optional deterministic booking-review demo, including guest review; not live booking consent.
BOOKING_DEMO_ENABLED=false
# Maximum simultaneous planning runs per guest session (1-20).
GUEST_MAX_ACTIVE_RUNS=2
# New planning runs per guest session per hour (1-100).
GUEST_MAX_RUNS_PER_HOUR=10
# New guest sessions per network per hour (1-200).
GUEST_MAX_SESSIONS_PER_HOUR=20
# Trust x-real-ip only behind a proxy that overwrites that header; false shares a conservative bucket.
GUEST_TRUST_PROXY_IP=false
# Optional separate network-hashing key; otherwise uses domain-separated HMAC with BETTER_AUTH_SECRET.
# GUEST_NETWORK_SECRET=replace-with-a-separate-at-least-32-character-secret

# Local-only database demo credentials. Preserve them when reusing the database volume.
POSTGRES_ADMIN_PASSWORD=synthetic-local-postgres-admin
APP_DB_PASSWORD=synthetic-local-app-db-password
MIGRATION_DB_PASSWORD=synthetic-local-migration-db-password
TEMPORAL_DB_PASSWORD=synthetic-local-temporal-db-password
WORKER_DB_PASSWORD=synthetic-local-worker-db-password
# Host-run services derive role-specific URLs from these passwords.
# Compose constructs container URLs from the same values. Host-run processes may set
# DATABASE_URL, MIGRATION_DATABASE_URL, or WORKER_DATABASE_URL to intentionally override.
# A generic DATABASE_URL is used by web; use WORKER_DATABASE_URL to override the worker URL.
# Local demo authentication/session signing key. Never reuse in production.
BETTER_AUTH_SECRET=synthetic-local-web-auth-secret-000000000
# Public browser origin. Open the app at this exact origin to preserve cookie/Origin checks.
BETTER_AUTH_URL=http://localhost:3000
# Web-to-agent API address; Docker uses http://agent:8000.
AGENT_BASE_URL=http://localhost:8000
# Agent-to-web callback/internal API address; Docker uses http://web:3000.
WEB_BASE_URL=http://localhost:3000
# Python agent runtime; separate from NODE_ENV.
ENVIRONMENT=development
# Local demo web/agent scoped-request signing key.
SERVICE_TOKEN_SECRET=synthetic-local-service-secret-000000000
# Local demo web-only pricing diagnostics signing key.
PRICING_DIAGNOSTIC_SECRET=synthetic-local-pricing-secret-000000000
# Host web/worker Temporal gRPC address; Docker overrides this with temporal:7233.
TEMPORAL_ADDRESS=localhost:7233

# Nebius Token Factory OpenAI-compatible API endpoint for live model inference.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Required in live mode; use your own Nebius API key, never a production customer credential.
NEBIUS_API_KEY=synthetic-nebius-key
# Required in live mode: replace with an exact model ID available to your Nebius account.
NEBIUS_MODEL=synthetic-model
# Answer budget in completion tokens (reasoning included) and per-request timeout.
NEBIUS_MAX_OUTPUT_TOKENS=4096
NEBIUS_REQUEST_TIMEOUT_SECONDS=90
# Google Maps Platform key. The agent uses Maps Grounding Lite; web uses the
# same key for Places text search and Time Zone lookup when PROVIDER_MODE=live.
MAPS_GROUNDING_API_KEY=synthetic-maps-key
# Required in live mode: Tavily /search API key for bounded, attributed web research.
TAVILY_API_KEY=synthetic-tavily-key

# Optional LangSmith trace export key; only used when tracing is enabled.
LANGSMITH_API_KEY=synthetic-langsmith-key
# Keep false for the default demo; enabling export in live/production requires a real key.
LANGSMITH_TRACING=false
# HTTPS LangSmith API endpoint; use the region matching your account.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Agent identity attached to redacted traces.
LANGSMITH_AGENT_ID=onholidai
# Deployment label attached to traces; independent of ENVIRONMENT runtime validation.
LANGSMITH_AGENT_ENVIRONMENT=local
# Host web OpenTelemetry HTTP collector endpoint; Docker uses http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Supplier discovery: Duffel flights, Nuitee accommodation, and Viator activities.
# JSON contains environment-variable NAMES, never credentials. Keep this value on one line.
# configured_unverified is not proof of provider access or verified inventory.
# No transaction references/operations are enabled by this read-only planning example.
# Live readiness needs reviewed evidence per product/operation; see docs/operations.md.
SUPPLIER_PROVIDERS='{"duffel":{"readSecretRef":"DUFFEL_READ_SECRET","products":{"flight":{"operations":{"search":{"support":"supported","access":"configured_unverified"}}}}},"nuitee":{"readSecretRef":"NUITEE_SECRET","products":{"accommodation":{"operations":{"search":{"support":"supported","access":"configured_unverified","environment":"sandbox"},"detail":{"support":"supported","access":"configured_unverified","environment":"sandbox"}}}}},"viator":{"readSecretRef":"VIATOR_SECRET","accessTier":"affiliate_basic","products":{"activity":{"operations":{"search":{"support":"supported","access":"configured_unverified"}}}}}}'
# Upstream Duffel flight-discovery token; forwarded to web by the base Compose file.
# Do not reuse a booking/transaction token here.
DUFFEL_READ_SECRET=synthetic-duffel-read-secret
# Optional separate transaction token for reviewed worker configuration, not this demo.
# DUFFEL_TRANSACTION_SECRET=synthetic-duffel-transaction-secret

# Nuitee / LiteAPI accommodation discovery key; forwarded to web only.
NUITEE_SECRET=synthetic-nuitee-key
# sandbox or production; must match your key and operation-readiness evidence.
NUITEE_ENVIRONMENT=sandbox

# Viator activity-discovery key; actual capabilities also depend on the declared access tier.
VIATOR_SECRET=synthetic-viator-key
# sandbox or production; use the environment approved for your provider account.
VIATOR_ENVIRONMENT=sandbox
