# Automatic HTTPS: Caddy obtains and renews certificates for both names.
# Used by infra/production/compose.yml unless CADDYFILE selects the HTTP-only
# variant for a bring-up before DNS exists.

www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# Compressed and long-cached framework assets; everything else stays dynamic.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	handle {
		reverse_proxy web:3000 {
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}

	log {
		output stdout
		format json
	}
}
