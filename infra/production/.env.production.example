# Production runtime configuration for infra/production/compose.yml.
#
# Copy to /srv/onholidai/.env.production on the VPS (mode 0600) and fill in the
# provider credentials. Database passwords are in /srv/onholidai/.db-passwords;
# signing keys are Docker secret files under SECRETS_DIR, created by bootstrap-vps.sh.
#
# Deploy agents pass this content through the PRODUCTION_ENV GitHub secret.

# Public origin. Must match the DNS record for the domain.
APP_DOMAIN=onholidai.nl
PUBLIC_ORIGIN=https://onholidai.nl
# Uncomment only for a temporary HTTP-only bring-up before DNS resolves here.
# CADDYFILE=./Caddyfile.http-only

# Absolute path to the directory holding the signing-key *.txt files.
SECRETS_DIR=/srv/onholidai/secrets

PROVIDER_MODE=live
BOOKING_DEMO_ENABLED=false
GUEST_MAX_ACTIVE_RUNS=2
GUEST_MAX_RUNS_PER_HOUR=10
GUEST_MAX_SESSIONS_PER_HOUR=20

NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=
NEBIUS_API_KEY=
MAPS_GROUNDING_API_KEY=
TAVILY_API_KEY=

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=onholidai
LANGSMITH_AGENT_ENVIRONMENT=production

# Supplier JSON must declare only operations that have verified access.
SUPPLIER_PROVIDERS='{}'
DUFFEL_READ_SECRET=
DUFFEL_TRANSACTION_SECRET=
NUITEE_SECRET=
NUITEE_ENVIRONMENT=sandbox
VIATOR_SECRET=
VIATOR_ENVIRONMENT=sandbox
